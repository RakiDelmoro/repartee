# Copy to /etc/repartee/repartee.env and adjust.
# systemd reads this file for both units.

REPARTEE_DATA=/var/lib/repartee/data
REPARTEE_KNOWLEDGE_BASE=/var/lib/repartee/knowledge-base
REPARTEE_STT_MODEL=/opt/repartee/models/LFM3-Omni-2B
REPARTEE_STT_DEVICE=cuda

# REPARTEE_SERIAL=/dev/ttyACM0
# REPARTEE_STT_LANGUAGE=English
# REPARTEE_SUMMARY=1
# REPARTEE_WORKER_POLL=2
